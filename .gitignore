# ─────────────────────────────────────────────────────────────────────────────
# DATA — never committed.
# HMD is free but redistribution is restricted by its user agreement: users
# must register and accept the terms themselves. Re-hosting the files here
# would breach that. Reproducibility is served by data/MANIFEST.sha256
# (checksums + vintage) plus the documented download procedure, NOT by the
# bytes. ~900 MB, would also blow past GitHub's repo size guidance.
# ─────────────────────────────────────────────────────────────────────────────
Dataset/
data/raw/
data/interim/
data/processed/
*.zip

# ─────────────────────────────────────────────────────────────────────────────
# LITERATURE — PDFs and extracted full text are publisher-copyrighted.
# Committing them is redistribution. The curated notes (INDEX.md, MISSING.md,
# GAP-ANALYSIS.md) are our own writing and ARE tracked.
# ─────────────────────────────────────────────────────────────────────────────
literature/pdf/
literature/pdf-other-datasets/
literature/txt/
*.pdf

# ── Backups / scratch ────────────────────────────────────────────────────────
*.ORIGINAL.*
*.bak
~$*.docx
~$*.xlsx

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.uv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.ruff_cache/
.mypy_cache/

# ── R ────────────────────────────────────────────────────────────────────────
.Rhistory
.RData
.Rproj.user/
*.Rproj

# ── Model artefacts / results too large or regenerable ───────────────────────
*.pt
*.pth
*.ckpt
*.joblib
*.pkl
results/**/samples/
mlruns/
wandb/

# ── LaTeX build products ─────────────────────────────────────────────────────
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.synctex.gz
*.toc

# ── OS / editor ──────────────────────────────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/

# parity panel exports are raw HMD data (redistribution-restricted); the
# fitted StMoMo parameter dump is our own work product and IS tracked
results/parity/D_*.csv
results/parity/E_*.csv

# Sweep-cost probe output: measurements, regenerable, machine-specific
results/timings*.json

# sweep scratch: per-population parts (resume checkpoints) and run logs are
# regenerable; the concatenated results/<regime>.parquet IS tracked
results/*.parts/
results/logs/

# server-side environment created by scripts/server_setup.sh
.venv-server/

# local snapshots of a running sweep (scripts/final_qa.py on partial pulls)
results/_*

# generated paper artefacts: regenerated from results/*.parquet by
# scripts/make_tables.py / make_figures.py / sensitivities.py; only the
# static grid table is hand-maintained. Final versions are committed
# deliberately once the sweeps are complete.
paper/tables/tab-*.tex
!paper/tables/tab-grid.tex
paper/figures/*.pdf
paper/figures/figures-manifest.json
results/sensitivities.json

# LaTeX build litter
paper/*.log
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.out
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
